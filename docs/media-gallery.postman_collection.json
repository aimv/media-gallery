{
  "info": {
    "name": "Media Gallery API",
    "description": "Коллекция запросов для демонстрации API медиагалереи и CMS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/healthz",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "healthz"
          ]
        }
      }
    },
    {
      "name": "Upload Media",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "multipart/form-data",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "/path/to/your/file.jpg",
              "description": "Выберите файл для загрузки (JPEG/PNG/MP4)"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8080/api/media/upload",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "media",
            "upload"
          ]
        }
      }
    },
    {
      "name": "Create CMS Block",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"page_key\": \"home\",\n  \"block_type\": \"carousel\",\n  \"data\": {\n    \"title\": \"Welcome to our gallery\",\n    \"subtitle\": \"Featured works\"\n  },\n  \"sort_order\": 1,\n  \"media_ids\": [\n    \"a1b2c3d4-e5f6-7890-abcd-ef1234567891\",\n    \"a1b2c3d4-e5f6-7890-abcd-ef1234567892\"\n  ]\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/cms/blocks",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "cms",
            "blocks"
          ]
        }
      }
    },
    {
      "name": "Get CMS Block by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/cms/blocks/a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "cms",
            "blocks",
            "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          ]
        }
      }
    }
  ]
}