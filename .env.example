# Копируйте этот файл в .env и заполните реальными значениями.

# Изолированные параметры СУБД (считываются как docker-compose, так и Go)
DB_USER=media_user
DB_PASSWORD=media_pass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=media_gallery

# Порт HTTP-сервера API
HTTP_SERVER_PORT=8080

# Секретный ключ для авторизации API (замените на случайное значение)
API_KEY=change-me

# Базовая директория для хранения загруженных файлов
STORAGE_DIR=./storage

# Максимальный размер загружаемого файла в байтах (500 МБ)
MAX_UPLOAD_SIZE=524288000

# Уровень логирования: debug, info, warn, error
LOG_LEVEL=info



