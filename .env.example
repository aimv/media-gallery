# HTTP
HTTP_PORT=8080

# PostgreSQL
#DB_DSN=postgres://media_user:media_pass@localhost:5432/media_gallery?sslmode=disable
DB_DSN=postgres://media_user:media_pass@postgres:5432/media_gallery?sslmode=disable

# Storage
STORAGE_ROOT=./tmp/storage

# Worker
WORKER_COUNT=1
CONCURRENCY_LIMIT=2
MAX_UPLOAD_SIZE=52428800

# Security
API_KEY=dev-api-key-change-me

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
LEASE_DURATION=30s

# Logging
LOG_LEVEL=info