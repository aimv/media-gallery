# HTTP
HTTP_PORT=8080

# PostgreSQL
DB_DSN=postgres://media_user:media_pass@localhost:5432/media_gallery?sslmode=disable

# Storage
STORAGE_ROOT=./tmp/storage

# Worker
WORKER_COUNT=1
LEASE_DURATION=5m
MAX_UPLOAD_SIZE_MB=500

# Security
API_KEY=dev-api-key-change-me

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Logging
LOG_LEVEL=info